generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id         Int      @id @default(autoincrement())
  telegramId String   @unique
  username   String?
  firstName  String?
  lastName   String?
  avatarUrl  String?
  totalScore Int      @default(0)
  createdAt  DateTime @default(now())

  topicScores UserTopicScore[]
  topicLocks  UserTopicLock[]
  collectionLocks UserCollectionLock[]
}

model Topic {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())

  questions   Question[]
  collections Collection[]
  rooms       Room[]
  topicScores UserTopicScore[]
  topicLocks  UserTopicLock[]
}

model Collection {
  id        Int      @id @default(autoincrement())
  topicId   Int
  name      String
  slug      String
  isActive  Boolean  @default(true)
  isFree    Boolean  @default(true)
  priceGems Int?
  createdAt DateTime @default(now())

  topic      Topic     @relation(fields: [topicId], references: [id])
  questions  Question[]
  locks      UserCollectionLock[]

  @@unique([topicId, slug])
}

model Question {
  id               Int      @id @default(autoincrement())
  topicId          Int
  text             String
  options          String   // JSON string: ["A", "B", "C", "D"]
  correctOption    Int?
  type             String   @default("single_choice") // single_choice | sequence
  correctSequence  String?  // JSON string for sequence answers
  difficultyPreset Int      @default(1) // 0-easy,1-medium,2-hard,3-hardcore
  picture          String?
  video            String?
  audio            String?
  createdAt        DateTime @default(now())

  topic Topic @relation(fields: [topicId], references: [id])
  collections Collection[]
}

model Room {
  id               String   @id
  topicId          Int
  difficulty       String
  questionsIdsJson String
  playersIdsJson   String
  status           String
  createdAt        DateTime @default(now())
  finishedAt       DateTime?

  topic Topic @relation(fields: [topicId], references: [id])
}

model UserTopicScore {
  userId  Int
  topicId Int
  score   Int @default(0)

  user  User  @relation(fields: [userId], references: [id])
  topic Topic @relation(fields: [topicId], references: [id])

  @@id([userId, topicId])
}

model UserTopicLock {
  userId   Int
  topicId  Int
  reason   String?
  lockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  topic Topic @relation(fields: [topicId], references: [id])

  @@id([userId, topicId])
}

model UserCollectionLock {
  userId       Int
  collectionId Int
  reason       String?
  lockedAt     DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id])
  collection Collection @relation(fields: [collectionId], references: [id])

  @@id([userId, collectionId])
}
