## Copy to `.env` and adjust for your environment.
## This file is committed; `.env` is local-only (ignored by git).

# Runtime
NODE_ENV=development
# Optional: distinguish deployments (e.g. dev/main) without affecting NODE_ENV logic
APP_ENV=dev

# Server
PORT=5001
FRONTEND_URL=http://localhost:5173

# Auth
JWT_SECRET=change-me
TELEGRAM_BOT_TOKEN=change-me

# Auth switches
# Telegram login mode for regular websites:
# - oauth: default Telegram OAuth (requires domain without custom port)
# - qr: QR/deeplink flow via Telegram Mini App (works with :8443)
AUTH_TELEGRAM_LOGIN_MODE=oauth

# Optional: enable/disable auth methods (future-proof)
AUTH_METHOD_TELEGRAM=true
AUTH_METHOD_EMAIL=false
AUTH_METHOD_VK=false

# Optional: QR token TTL (ms)
AUTH_TELEGRAM_QR_TTL_MS=120000

# Database (SQLite, local file)
DATABASE_URL="file:./dev.db"

# Feature flags
FEATURE_DIFFICULTY_SELECTION=false
FEATURE_PLAYERS_LIST_IN_GAME=true
FEATURE_BOTS=false

# Logging
LOG_ROOMS=true
LOG_SOCKETS=true
DEBUG_SESSIONS=false

# Game / rooms tuning (optional)
QUESTIONS_PER_GAME=5
MAX_PLAYERS_PER_ROOM=50
BOTS_PER_ROOM=49

