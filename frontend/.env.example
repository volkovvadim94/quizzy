## Copy to `.env` for local dev.
## For production build, use `.env.production` (Vite reads by mode).

VITE_API_URL=http://localhost:5001/api
VITE_SOCKET_URL=http://localhost:5001
VITE_TELEGRAM_BOT_ID=change-me

# Optional UI flags (final flags can come from GET /api/config)
VITE_FEATURE_QUESTION_RATING=false

